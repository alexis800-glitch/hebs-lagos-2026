{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://hebslagos.com/schemas/hebs-2027-form-request-v1.0.json",
 "title": "HEBS 2027 public form request (website server -> portal evSubmitPublicForm), contract v1.0",
 "type": "object",
 "required": [
  "form",
  "edition",
  "client_request_id",
  "data"
 ],
 "properties": {
  "form": {
   "enum": [
    "priority",
    "sponsor",
    "exhibitor",
    "enquiry"
   ]
  },
  "edition": {
   "const": "2027"
  },
  "client_request_id": {
   "type": "string",
   "format": "uuid",
   "description": "UUID v4, created once per submission on the website server and reused on retry"
  },
  "website": {
   "type": "string",
   "maxLength": 0,
   "description": "Honeypot. Must be empty; a non-empty value returns 202 and stores nothing."
  },
  "data": {
   "type": "object"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "form": {
      "const": "priority"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "type": "object",
      "required": [
       "full_name",
       "email"
      ],
      "properties": {
       "full_name": {
        "type": "string",
        "maxLength": 200
       },
       "email": {
        "type": "string",
        "maxLength": 200,
        "format": "email"
       },
       "phone": {
        "type": "string",
        "maxLength": 40
       },
       "country": {
        "type": "string",
        "maxLength": 100
       },
       "city": {
        "type": "string",
        "maxLength": 100
       },
       "company": {
        "type": "string",
        "maxLength": 200
       },
       "interest": {
        "type": "string",
        "enum": [
         "Attendee",
         "Contestant",
         "Sponsor",
         "Exhibitor",
         "Media",
         "Other"
        ]
       },
       "category_interest": {
        "type": "string",
        "maxLength": 200
       },
       "utm_source": {
        "type": "string",
        "maxLength": 100
       },
       "utm_medium": {
        "type": "string",
        "maxLength": 100
       },
       "utm_campaign": {
        "type": "string",
        "maxLength": 100
       },
       "consent_marketing": {
        "type": "boolean"
       },
       "consent_version": {
        "type": "string",
        "maxLength": 40
       }
      },
      "additionalProperties": false
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "form": {
      "const": "sponsor"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "type": "object",
      "required": [
       "company_name",
       "email"
      ],
      "properties": {
       "company_name": {
        "type": "string",
        "maxLength": 200
       },
       "contact_person": {
        "type": "string",
        "maxLength": 200
       },
       "email": {
        "type": "string",
        "maxLength": 200,
        "format": "email"
       },
       "phone": {
        "type": "string",
        "maxLength": 40
       },
       "tier_interest": {
        "type": "string",
        "maxLength": 60
       },
       "budget_range": {
        "type": "string",
        "maxLength": 60
       },
       "message": {
        "type": "string",
        "maxLength": 2000
       }
      },
      "additionalProperties": false
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "form": {
      "const": "exhibitor"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "type": "object",
      "required": [
       "business_name",
       "email"
      ],
      "properties": {
       "business_name": {
        "type": "string",
        "maxLength": 200
       },
       "contact_person": {
        "type": "string",
        "maxLength": 200
       },
       "email": {
        "type": "string",
        "maxLength": 200,
        "format": "email"
       },
       "phone": {
        "type": "string",
        "maxLength": 40
       },
       "business_category": {
        "type": "string",
        "maxLength": 100
       },
       "product_service": {
        "type": "string",
        "maxLength": 1000
       },
       "booth_requirement": {
        "type": "string",
        "maxLength": 60
       }
      },
      "additionalProperties": false
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "form": {
      "const": "enquiry"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "type": "object",
      "required": [
       "name",
       "email",
       "message"
      ],
      "properties": {
       "name": {
        "type": "string",
        "maxLength": 200
       },
       "email": {
        "type": "string",
        "maxLength": 200,
        "format": "email"
       },
       "phone": {
        "type": "string",
        "maxLength": 40
       },
       "subject": {
        "type": "string",
        "maxLength": 200
       },
       "message": {
        "type": "string",
        "maxLength": 2000
       }
      },
      "additionalProperties": false
     }
    }
   }
  }
 ],
 "additionalProperties": false
}
